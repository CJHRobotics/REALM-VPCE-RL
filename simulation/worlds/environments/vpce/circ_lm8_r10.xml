<?xml version="1.0" encoding="us-ascii"?>

<!-- Circular arena, radius 10 m, area 314.16 m^2, with 8 landmarks of 0.75 m.
     XML `radius` is the inner walkable radius; the wall material
     extends outward by `thickness`. Panels sit flush on the inner
     face. Interlandmark spacing along the wall is 7.85 m; the panels cover 9.5% of
     the circumference. Landmark bearings are anchored at 90 deg,
     off the camera view seams: [90.0, 135.0, 180.0, 225.0, 270.0, 315.0, 360.0, 405.0] -->

<world>
	<circular_wall radius="10" height="0.5" thickness="0.5" subdivision="128"/>

    <landmark type="panel" x=" 0.0000" y=" 9.9780" theta="-1.5708" height="0.75" width="0.75"
              texture="../protos/world_objects/textures/flags/flag_0.png"
              red="1.00" green="0.00" blue="0.00"/>
    <landmark type="panel" x="-7.0555" y=" 7.0555" theta="-0.7854" height="0.75" width="0.75"
              texture="../protos/world_objects/textures/flags/flag_1.png"
              red="0.00" green="1.00" blue="0.00"/>
    <landmark type="panel" x="-9.9780" y=" 0.0000" theta=" 0.0000" height="0.75" width="0.75"
              texture="../protos/world_objects/textures/flags/flag_2.png"
              red="0.00" green="0.00" blue="1.00"/>
    <landmark type="panel" x="-7.0555" y="-7.0555" theta=" 0.7854" height="0.75" width="0.75"
              texture="../protos/world_objects/textures/flags/flag_3.png"
              red="1.00" green="1.00" blue="0.00"/>
    <landmark type="panel" x=" 0.0000" y="-9.9780" theta=" 1.5708" height="0.75" width="0.75"
              texture="../protos/world_objects/textures/flags/flag_4.png"
              red="0.00" green="1.00" blue="1.00"/>
    <landmark type="panel" x=" 7.0555" y="-7.0555" theta=" 2.3562" height="0.75" width="0.75"
              texture="../protos/world_objects/textures/flags/flag_5.png"
              red="1.00" green="0.50" blue="0.00"/>
    <landmark type="panel" x=" 9.9780" y=" 0.0000" theta=" 3.1416" height="0.75" width="0.75"
              texture="../protos/world_objects/textures/flags/flag_6.png"
              red="0.50" green="0.00" blue="0.50"/>
    <landmark type="panel" x=" 7.0555" y=" 7.0555" theta=" 3.9270" height="0.75" width="0.75"
              texture="../protos/world_objects/textures/flags/flag_7.png"
              red="0.00" green="0.50" blue="0.50"/>

    <!-- Six episode starts, alternating r = 8 and r = 5 so they differ in
         distance to the goal as well as in bearing.

         The BEARINGS are chosen rather than evenly spaced, and that is the
         point. The action set is allocentric: action k always moves along
         world bearing 45k degrees. So a start whose bearing to the goal is
         a multiple of 45 can be reached by repeating ONE action, with no
         policy at all. The first version of this file spaced the starts
         every 60 degrees, which put two of the six (at 0 and 180) exactly
         on action rays: 33 percent success before any training, seen as 20
         percent and 50 percent pre-training baselines on two real runs. A
         floor like that sits under every condition and compresses the
         range a comparison between representations has to work in.

         Six starts 60 degrees apart CANNOT all avoid this. 60 mod 45 is
         15, so their bearings occupy residues k, k+15 and k+30 mod 45, a
         30 degree span inside a 45 degree period, too wide to fit in the
         window that keeps every start clear of a ray. Even spacing has to
         give. These sit on the midpoints between action rays (22.5 + 45k),
         maximally far from any of them: a straight run from the nearest
         start misses the goal by 1.91 m against a 0.8 m goal radius, and
         from the far starts by 3.06 m.

         theta is cosmetic. The VPCE observation spans all eight headings so
         it does not depend on facing, and the starting heading changes
         neither what the agent sees nor what its actions mean. They face
         the centre because it reads better in the path plots. -->
    <train_start_positions>
        <pos x="  7.3910" y="  3.0615" theta="-2.7489"/>   <!--  22.5 deg, r = 8 m -->
        <pos x="  1.9134" y="  4.6194" theta="-1.9635"/>   <!--  67.5 deg, r = 5 m -->
        <pos x=" -7.3910" y="  3.0615" theta="-0.3927"/>   <!-- 157.5 deg, r = 8 m -->
        <pos x=" -4.6194" y=" -1.9134" theta=" 0.3927"/>   <!-- 202.5 deg, r = 5 m -->
        <pos x=" -3.0615" y=" -7.3910" theta=" 1.1781"/>   <!-- 247.5 deg, r = 8 m -->
        <pos x="  4.6194" y=" -1.9134" theta=" 2.7489"/>   <!-- 337.5 deg, r = 5 m -->
    </train_start_positions>

    <test_start_positions>
        <pos x="0.0" y="0.0" theta="0.0"/>
    </test_start_positions>

    <goal id="0" x="0.0" y="0.0"/>
</world>
