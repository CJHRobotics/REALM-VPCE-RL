<?xml version="1.0" encoding="us-ascii"?>

<!-- Circular arena, radius 10 m, area 314.16 m^2, with 8 landmarks of 0.75 m.
     XML `radius` is the inner walkable radius; the wall material
     extends outward by `thickness`. Panels sit flush on the inner
     face. Interlandmark spacing along the wall is 7.85 m; the panels cover 9.5% of
     the circumference. Landmark bearings are anchored at 90 deg,
     off the camera view seams: [90.0, 135.0, 180.0, 225.0, 270.0, 315.0, 360.0, 405.0] -->

<world>
	<circular_wall radius="10" height="0.5" thickness="0.5" subdivision="128"/>

    <landmark type="panel" x=" 0.0000" y=" 9.9780" theta="-1.5708" height="0.75" width="0.75"
              texture="../protos/world_objects/textures/flags/flag_0.png"
              red="1.00" green="0.00" blue="0.00"/>
    <landmark type="panel" x="-7.0555" y=" 7.0555" theta="-0.7854" height="0.75" width="0.75"
              texture="../protos/world_objects/textures/flags/flag_1.png"
              red="0.00" green="1.00" blue="0.00"/>
    <landmark type="panel" x="-9.9780" y=" 0.0000" theta=" 0.0000" height="0.75" width="0.75"
              texture="../protos/world_objects/textures/flags/flag_2.png"
              red="0.00" green="0.00" blue="1.00"/>
    <landmark type="panel" x="-7.0555" y="-7.0555" theta=" 0.7854" height="0.75" width="0.75"
              texture="../protos/world_objects/textures/flags/flag_3.png"
              red="1.00" green="1.00" blue="0.00"/>
    <landmark type="panel" x=" 0.0000" y="-9.9780" theta=" 1.5708" height="0.75" width="0.75"
              texture="../protos/world_objects/textures/flags/flag_4.png"
              red="0.00" green="1.00" blue="1.00"/>
    <landmark type="panel" x=" 7.0555" y="-7.0555" theta=" 2.3562" height="0.75" width="0.75"
              texture="../protos/world_objects/textures/flags/flag_5.png"
              red="1.00" green="0.50" blue="0.00"/>
    <landmark type="panel" x=" 9.9780" y=" 0.0000" theta=" 3.1416" height="0.75" width="0.75"
              texture="../protos/world_objects/textures/flags/flag_6.png"
              red="0.50" green="0.00" blue="0.50"/>
    <landmark type="panel" x=" 7.0555" y=" 7.0555" theta=" 3.9270" height="0.75" width="0.75"
              texture="../protos/world_objects/textures/flags/flag_7.png"
              red="0.00" green="0.50" blue="0.50"/>

    <!-- Six episode starts, 60 deg apart, alternating r = 8 and r = 5 so they
         differ in distance to the goal as well as in bearing. The goal is at
         the origin, so each is a different length of journey inward and sees
         a different pair of landmarks ahead.

         theta is cosmetic here: the VPCE observation spans all eight headings
         so it does not depend on facing, and the action set is allocentric
         (action k is always world bearing 45k deg), so the starting heading
         changes neither what the agent sees nor what its actions mean. They
         face the centre because it reads better in the path plots. -->
    <train_start_positions>
        <pos x="  8.0000" y="  0.0000" theta="-3.1416"/>   <!--   0 deg, r = 8.0 m -->
        <pos x="  2.5000" y="  4.3301" theta="-2.0944"/>   <!--  60 deg, r = 5.0 m -->
        <pos x=" -4.0000" y="  6.9282" theta="-1.0472"/>   <!-- 120 deg, r = 8.0 m -->
        <pos x=" -5.0000" y="  0.0000" theta="-0.0000"/>   <!-- 180 deg, r = 5.0 m -->
        <pos x=" -4.0000" y=" -6.9282" theta=" 1.0472"/>   <!-- 240 deg, r = 8.0 m -->
        <pos x="  2.5000" y=" -4.3301" theta=" 2.0944"/>   <!-- 300 deg, r = 5.0 m -->
    </train_start_positions>

    <test_start_positions>
        <pos x="0.0" y="0.0" theta="0.0"/>
    </test_start_positions>

    <goal id="0" x="0.0" y="0.0"/>
</world>
